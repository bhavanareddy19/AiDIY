# Flask Configuration
FLASK_SECRET_KEY=your_flask_secret_key_here_change_me
DEV_MODE=True

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/aidiy_app
# Or use MongoDB Atlas:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/aidiy_app

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_me

# Email Configuration (Gmail example)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Google OAuth Configuration
# Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Development Mode
# Set to True to skip email verification during development
DEV_MODE=True
